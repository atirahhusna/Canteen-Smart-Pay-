    "build": "electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "build": "^0.1.4",
    "font-awesome": "^4.7.0",
    "jquery": "^3.7.1",
    "qrcode": "^1.5.4",
    "qrcodejs2": "^0.0.2",
