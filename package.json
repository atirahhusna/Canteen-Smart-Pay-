  },
  "devDependencies": {
    "electron": "^40.8.5",
    "electron-builder": "^26.15.3",
    "electron-builder-squirrel-windows": "^26.8.1",
    "electron-publish": "^26.8.1",
    "electron-rebuild": "^2.0.3"
  },
  "build": {
    "appId": "com.murata.canteensmartpaysystem",
    "win": {
      "target": "nsis",
      "icon": "images/favicon.ico"
    },
    "extraResources": [
      {
        "from": "images",
        "to": "images",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "js",
        "to": "js",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "css",
        "to": "css",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
